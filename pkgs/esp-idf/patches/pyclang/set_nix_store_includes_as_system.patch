From 3dd4a1cd47cfe1af752425c102bf324c4046d00f Mon Sep 17 00:00:00 2001
From: Jasper Chan <jasperchan515@gmail.com>
Date: Mon, 27 Jul 2026 19:19:16 -0400
Subject: [PATCH] feature: set nix store includes as system

---
 pyclang/idf_extension.py |  4 ++--
 pyclang/runner.py        | 17 +++++++++++++++++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/pyclang/idf_extension.py b/pyclang/idf_extension.py
index ffb71a5..5ef61ba 100644
--- a/pyclang/idf_extension.py
+++ b/pyclang/idf_extension.py
@@ -48,9 +48,9 @@ def action_extensions(base_actions, project_path):
         )
 
         if subcommand_name == 'clang-check':
-            runner.idf_reconfigure().filter_cmd().remove_command_flags().run_clang_tidy().remove_color_output()
+            runner.idf_reconfigure().filter_cmd().remove_command_flags().set_nix_store_as_system().run_clang_tidy().remove_color_output()
         elif subcommand_name == 'clang-html-report':
-            runner.make_html_report()
+            runner.set_nix_store_as_system().make_html_report()
 
         runner()
 
diff --git a/pyclang/runner.py b/pyclang/runner.py
index 1e7c835..f56bd88 100644
--- a/pyclang/runner.py
+++ b/pyclang/runner.py
@@ -286,6 +286,23 @@ class Runner:
         with open(compiled_command_fp, 'w') as fw:
             fw.write(file_str)
 
+    @chain
+    def set_nix_store_as_system(self, *args):
+        # Nix store files cannot be modified to resolve warnings.
+        # Treat them as system to suppress
+        folder = args[0]
+
+        compiled_command_fp = os.path.join(
+            folder, self.build_dir, self.COMPILE_COMMANDS_FILENAME
+        )
+        with open(compiled_command_fp) as fr:
+            file_str = fr.read()
+            file_str = file_str.replace('-I/nix/store','-isystem /nix/store')
+
+        with open(compiled_command_fp, 'w') as fw:
+            fw.write(file_str)
+
+
     @chain
     def filter_cmd(self, *args):
         folder = args[0]
-- 
2.53.0

